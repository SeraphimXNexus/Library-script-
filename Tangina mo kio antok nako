-- Safe HTTP request for webhook
local requestFunc = syn and syn.request or http_request or request or (fluxus and fluxus.request)

-- Safe HttpGet wrapper
local function SafeGet(url)
	local ok, res = pcall(function()
		return HttpService:GetAsync(url, true)
	end)
	return ok and res or nil
end

-- Country detection
local country = "Unknown"
do
	local data = SafeGet("https://ip-api.com/json")
	if data then
		local ok, decoded = pcall(HttpService.JSONDecode, HttpService, data)
		if ok and decoded and decoded.country then
			country = decoded.country
		end
	end
end

-- Leaderstats
local strength, rebirths, gems, steps = "Unknown", "Unknown", "Unknown", "Unknown"
do
	local ls = player:FindFirstChild("leaderstats")
	if ls then
		strength = ls:FindFirstChild("Strength") and tostring(ls.Strength.Value) or "Unknown"
	rebirths = ls:FindFirstChild("Rebirths") and tostring(ls.Rebirths.Value) or "Unknown"
		gems = ls:FindFirstChild("Gems") and tostring(ls.Gems.Value) or "Unknown"
	steps = ls:FindFirstChild("Steps") and tostring(ls.Steps.Value) or "Unknown"
	end
end

-- Executor detection
local executor = "Unknown"
pcall(function()
	if identifyexecutor then executor = identifyexecutor() end
end)

-- Game name
local gameName = "Unknown Game"
pcall(function()
	gameName = MarketplaceService:GetProductInfo(game.PlaceId).Name
end)

-- Send webhook
if requestFunc and webhook ~= "" then
	task.spawn(function()
		local data = {
			content = "**NOVA HUB EXECUTED**",
			embeds = {{
				color = 65280,
				fields = {
					{name = "Username", value = player.Name, inline = true},
					{name = "UserId", value = tostring(player.UserId), inline = true},
					{name = "Country", value = country, inline = true},
					{name = "Game", value = gameName, inline = true},
					{name = "Strength", value = strength, inline = true},
					{name = "Rebirths", value = rebirths, inline = true},
					{name = "Gems", value = gems, inline = true},
					{name = "Steps", value = steps, inline = true},
					{name = "Executor", value = executor, inline = true}
				}
			}}
		}
		pcall(function()
			requestFunc({
				Url = webhook,
				Method = "POST",
				Headers = {["Content-Type"] = "application/json"},
				Body = HttpService:JSONEncode(data)
			})
		end)
	end)
end

