-- Centralized iPhone-style visual adjustments
local function apply_iOS_style()
	local accent = ui_options.main_color or Color3.fromRGB(10,132,255)
	local window_trans = ui_options.window_transparency or 0.55
	local surface_trans = ui_options.surface_transparency or 0.40
	-- Apply to prefabs: image color, transparency, fonts, and button accenting
	for _, obj in ipairs(Prefabs:GetDescendants()) do
		-- For image-based frames make them rounded & translucent
		if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
			-- keep slice behavior for round corners
			pcall(function()
				obj.ScaleType = Enum.ScaleType.Slice
				if obj.SliceCenter == nil then
					obj.SliceCenter = Rect.new(4,4,4,4)
				end
			end)
			-- Use a soft surface color to simulate frosted glass (not solid black)
			if obj.Name == "Window" then
				obj.ImageTransparency = window_trans
				obj.ImageColor3 = Color3.new(1,1,1)
			else
				-- keep palette & unique assets as-is; otherwise give a frosted surface
				if not (obj.Name == "Palette" or obj.Name == "Indicator" or obj.Name == "Sample" or obj.Name == "Saturation") then
					obj.ImageColor3 = Color3.fromRGB(245,245,250)
					obj.ImageTransparency = surface_trans
				end
			end
		end

		-- Text styling for readability
		if obj:IsA("TextLabel") or obj:IsA("TextBox") then
			-- favor a clean, readable font and dark text color
			pcall(function() obj.Font = Enum.Font.Gotham end)
			obj.TextColor3 = obj.TextColor3 or Color3.fromRGB(24,24,24)
		end

		if obj:IsA("TextButton") then
			pcall(function() obj.Font = Enum.Font.Gotham end)
			-- primary buttons (heuristic: name contains "Button" or parent is a Button)
			local name = tostring(obj.Name):lower()
			if name:find("button") or (obj.Parent and tostring(obj.Parent.Name):lower():find("button")) then
				-- set accent background using the roundify image if present
				local round = obj:FindFirstChildWhichIsA('ImageLabel') or obj.Parent:FindFirstChildWhichIsA('ImageLabel')
				if round and round:IsA("ImageLabel") then
					round.Image = round.Image or "rbxassetid://2851929490"
					round.ImageColor3 = accent
					round.ImageTransparency = 0
					pcall(function()
						round.ScaleType = Enum.ScaleType.Slice
						round.SliceCenter = Rect.new(4,4,4,4)
					end)
				else
					obj.BackgroundColor3 = accent
					obj.BackgroundTransparency = 0
				end
				-- readable white text on accent
				obj.TextColor3 = Color3.fromRGB(255,255,255)
			else
				-- neutral/secondary buttons: lighter background
				obj.TextColor3 = Color3.fromRGB(24,24,24)
			end
		end

		-- Ensure icons are readable (dark-gray)
		if obj:IsA("ImageLabel") and obj.Name:lower():find("toggle") then
			obj.ImageColor3 = Color3.fromRGB(255,255,255)
			obj.ImageTransparency = 0
		end
	end

	-- Update any Window instances already present in Windows (if any)
	for _, win in ipairs(Windows:GetChildren()) do
		if win:IsA("ImageLabel") and win.Name == "Window" then
			win.ImageColor3 = Color3.new(1,1,1)
			win.ImageTransparency = window_trans
		end
	end
end

-- run style application once prefabs are built
spawn(function()
	apply_iOS_style()
end)

